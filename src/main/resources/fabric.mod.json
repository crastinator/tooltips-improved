{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Makes tooltips readable and more useful: wraps, repositions and scrolls long tooltips, folds armor trims, and adds exact durability, equipment comparison, and previews of books, maps, banners and fireworks.",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/tooltips-improved",
    "sources": "https://github.com/crastinator/tooltips-improved",
    "issues": "https://github.com/crastinator/tooltips-improved/issues"
  },
  "license": "MIT",
  "icon": "assets/tooltipsimproved/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.tooltipsimproved.TooltipsImprovedFabric"
    ],
    "modmenu": [
      "com.tooltipsimproved.TooltipsImprovedModMenu"
    ]
  },
  "mixins": [
    "tooltipsimproved.mixins.json"
  ],
  "accessWidener": "tooltipsimproved.ct",
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}"
  }
}
